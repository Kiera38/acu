func main() Int:
    let a = [10, 100, 30, 7]
    bubble_sort(a as Ptr[Int], 4)
    return 0


func bubble_sort(a: Ptr[Int], n: Int):
    i = 0
    while i < n -1:
        swapped = 0
        j = 0
        while j < n-i-1:
            if a[j] > a[j+1]:
                t = a[j+1]
                a[j+1] = a[j]
                a[j] = t
                swapped = 1
            j+=1
        if not swapped:
            break
        i+=1
